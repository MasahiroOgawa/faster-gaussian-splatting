# Toolchain for building this project's CUDA extensions, loaded via `uv run --env-file .env`.
#
# uv manages Python and the virtualenv; it does not manage a CUDA SDK, which is what these
# variables point at. Two things shape this file:
#
#  * uv sets PATH itself (venv/bin first) and discards any PATH assigned here, so every tool
#    is named by absolute path. torch finds nvcc as $CUDA_HOME/bin/nvcc and forwards $CC to
#    it via -ccbin, so nothing needs to be on PATH.
#  * ${PWD} is expanded by uv at launch, so paths stay relative to the repository in the file
#    but reach subprocesses as absolute ones. Run `uv run` from the repository root.
#
# The system nvcc may be too old to target recent GPUs (sm_120 needs >= 12.8), and CUDA <= 13.0
# headers collide with glibc 2.41+ C23 rsqrt/cospi/sinpi declarations, hence a local 13.2.
CUDA_HOME=${PWD}/.toolchain/cuda-13.2
CUDA_PATH=${PWD}/.toolchain/cuda-13.2
LD_LIBRARY_PATH=${PWD}/.toolchain/cuda-13.2/lib64

# nvcc invokes unversioned `gcc`/`g++`; .toolchain/bin holds symlinks to the versioned ones.
CC=${PWD}/.toolchain/bin/gcc
CXX=${PWD}/.toolchain/bin/g++
CUDAHOSTCXX=${PWD}/.toolchain/bin/g++

# Restrict codegen to this machine's architecture; also keeps compile times down.
TORCH_CUDA_ARCH_LIST=12.0
MAX_JOBS=8
