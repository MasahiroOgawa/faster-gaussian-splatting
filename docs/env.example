# Toolchain for building this project's CUDA extensions, loaded via `uv run --env-file .env`.
#
# uv manages Python and the virtualenv; it does not manage a CUDA SDK, which is what these
# variables point at. Note that uv sets PATH itself (venv/bin first), so PATH cannot be
# injected here -- every tool is therefore referenced by absolute path instead. torch finds
# nvcc as $CUDA_HOME/bin/nvcc and passes $CC to it via -ccbin, so no PATH entry is needed.
#
# The system nvcc (12.4) cannot target this GPU (RTX 5060 Ti, sm_120), and CUDA <= 13.0
# headers collide with glibc 2.43's C23 rsqrt/cospi/sinpi declarations, hence a local 13.2.
CUDA_HOME=/home/mas/proj/study/nerficg/.toolchain/cuda-13.2
CUDA_PATH=/home/mas/proj/study/nerficg/.toolchain/cuda-13.2
LD_LIBRARY_PATH=/home/mas/proj/study/nerficg/.toolchain/cuda-13.2/lib64

# Only gcc-13/g++-13 are installed; .toolchain/bin holds unversioned symlinks to them.
CC=/home/mas/proj/study/nerficg/.toolchain/bin/gcc
CXX=/home/mas/proj/study/nerficg/.toolchain/bin/g++
CUDAHOSTCXX=/home/mas/proj/study/nerficg/.toolchain/bin/g++

TORCH_CUDA_ARCH_LIST=12.0
MAX_JOBS=8
