# Source this before running any NeRFICG script:  source env.sh
# Replaces the conda environment from environments/*.yaml with a uv-managed venv
# plus a local, sudo-free CUDA toolchain.
NERFICG_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --- CUDA toolchain -----------------------------------------------------------
# The system nvcc (12.4) cannot target this GPU (RTX 5060 Ti, sm_120), and every
# CUDA <= 13.0 header set collides with glibc 2.43's C23 rsqrt/cospi/sinpi
# declarations. CUDA 13.2 is the first release that compiles cleanly here.
export CUDA_HOME="$NERFICG_ROOT/.toolchain/cuda-13.2"
export CUDA_PATH="$CUDA_HOME"
export LD_LIBRARY_PATH="$CUDA_HOME/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# --- host compiler ------------------------------------------------------------
# Only gcc-13/g++-13 are installed; nvcc looks for plain `gcc`/`g++`.
export PATH="$NERFICG_ROOT/.toolchain/bin:$CUDA_HOME/bin:$NERFICG_ROOT/.venv/bin:$PATH"
export CC="$NERFICG_ROOT/.toolchain/bin/gcc"
export CXX="$NERFICG_ROOT/.toolchain/bin/g++"
export CUDAHOSTCXX="$CXX"

# --- extension build settings -------------------------------------------------
export TORCH_CUDA_ARCH_LIST="12.0"   # sm_120 only: nothing else runs on this box
export MAX_JOBS="${MAX_JOBS:-8}"
export VIRTUAL_ENV="$NERFICG_ROOT/.venv"
export PYTHONPATH="$NERFICG_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
